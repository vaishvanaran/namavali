{"id":"hanuman-chalisa","title":"हनुमान् चालीसा","blocks":[{"t":"shloka","x":["श्रीगुरु चरन सरोज रज","निज मनु मुकुर सुधार।","बरनऊँ रघुवर विमल यश","जो दायकु फल चार॥"]},{"t":"shloka","x":["बुद्धिहीन तनु जानिके","सुमिरौं पवनकुमार।","बल बुद्धि विद्या देहु मोहिं","हरहु कलेस विकार॥"]},{"t":"head","x":"चौपाई"},{"t":"shloka","x":["जय हनुमान ज्ञान गुण सागर।","जय कपीश तिहुँ लोक उजागर॥१॥"]},{"t":"shloka","x":["राम दूत अतुलित बल धामा।","अञ्जनिपुत्र पवनसुत नामा॥२॥"]},{"t":"shloka","x":["महावीर विक्रम बजरङ्गी।","कुमति निवार सुमति के सङ्गी॥३॥"]},{"t":"shloka","x":["कञ्चन बरन विराज सुवेसा।","कानन कुण्डल कुञ्चित केशा॥४॥"]},{"t":"shloka","x":["हाथ वज्र औ ध्वजा विराजै।","काँधे मूँज जनेऊ साजै॥५॥"]},{"t":"shloka","x":["सङ्कर सुवन केसरीनन्दन।","तेज प्रताप महा जग वन्दन॥६॥"]},{"t":"shloka","x":["विद्यावान गुणी अति चातुर।","राम काज करिबे को आतुर॥७॥"]},{"t":"shloka","x":["प्रभु चरित्र सुनिबे को रसिया।","राम लखन सीता मन बसिया॥८॥"]},{"t":"shloka","x":["राम लक्ष्मण जानकी।","जय बोलो हनुमान् की॥"]},{"t":"shloka","x":["सूक्ष्म रूप धरि सियहिं दिखावा।","विकट रूप धरि लङ्क जरावा॥९॥"]},{"t":"shloka","x":["भीम रूप धरि असुर सँहारे।","रामचन्द्र के काज सँवारे॥१०॥"]},{"t":"shloka","x":["लाय सजीवन लखन जियाये।","श्रीरघुवीर हरषि उर लाये॥११॥"]},{"t":"shloka","x":["रघुपति कीन्ही बहुत बडाई।","तुम मम प्रिय भरत सम भाई॥१२॥"]},{"t":"shloka","x":["सहस वदन तुम्हरो यश गावैं।","अस कहि श्रीपति कण्ठ लगावैं॥१३॥"]},{"t":"shloka","x":["सनकादिक ब्रह्मादि मुनीशा।","नारद शारद सहित अहीशा॥१४॥"]},{"t":"shloka","x":["यम कुबेर दिक्पाल जहाँ ते।","कवि कोविद कहि सके कहाँ ते॥१५॥"]},{"t":"shloka","x":["तुम उपकार सुग्रीवहिं कीन्हा।","राम मिलाय राज पद दीन्हा॥१६॥"]},{"t":"shloka","x":["राम लक्ष्मण जानकी।","जय बोलो हनुमान् की॥"]},{"t":"shloka","x":["तुम्हरो मन्त्र विभीषण माना।","लङ्केश्वर भये सब जग जाना॥१७॥"]},{"t":"shloka","x":["युग सहस्र योजन पर भानू।","लील्यो ताहि मधुर फल जानू॥१८॥"]},{"t":"shloka","x":["प्रभु मुद्रिका मेलि मुख माहीं।","जलधि लाँघि गये अचरज नाहीं॥१९॥"]},{"t":"shloka","x":["दुर्गम काज जगत के जेते।","सुगम अनुग्रह तुम्हरे तेते॥२०॥"]},{"t":"shloka","x":["राम दुआरे तुम रखवारे।","होत न आज्ञा बिन पैसारे॥२१॥"]},{"t":"shloka","x":["सब सुख लहै तुम्हारी सरना।","तुम रक्षक काहू को डर ना॥२२॥"]},{"t":"shloka","x":["आपन तेज सम्हारो आपै।","तीनों लोक हाँक तें काँपै॥२३॥"]},{"t":"shloka","x":["भूत पिशाच निकट नहिं आवै।","महावीर जब नाम सुनावै॥२४॥"]},{"t":"shloka","x":["राम लक्ष्मण जानकी।","जय बोलो हनुमान् की॥"]},{"t":"shloka","x":["नाशै रोग हरै सब पीरा।","जपत निरन्तर हनुमत वीरा॥२५॥"]},{"t":"shloka","x":["सङ्कट से हनुमान छुडावै।","मन क्रम वचन ध्यान जो लावै॥२६॥"]},{"t":"shloka","x":["सब पर राम तपस्वी राजा।","तिन के काज सकल तुम साजा॥२७॥"]},{"t":"shloka","x":["और मनोरथ जो कोई लावै।","दासु अमित जीवन फल पावै॥२८॥"]},{"t":"shloka","x":["चारों युग प्रताप तुम्हारा।","है प्रसिद्ध जगत उजियारा॥२९॥"]},{"t":"shloka","x":["साधु सन्त के तुम रखवारे।","असुर निकन्दन राम दुलारे॥३०॥"]},{"t":"shloka","x":["अष्ट सिद्धि नव निधि के दाता।","अस बर दीन जानकी माता॥३१॥"]},{"t":"shloka","x":["राम रसायन तुम्हरे पासा।","सदा रहो रघुपति के दासा॥३२॥"]},{"t":"shloka","x":["राम लक्ष्मण जानकी।","जय बोलो हनुमान् की॥"]},{"t":"shloka","x":["तुम्हरे भजन राम को पावै।","जन्म जन्म के दुख बिसरावै॥३३॥"]},{"t":"shloka","x":["अन्त काल रघुपति पुर जाई।","जहाँ जन्मि हरिभक्त कहाई॥३४॥"]},{"t":"shloka","x":["और देवता चित्त न धरई।","हनुमत सेई सर्व सुख करई॥३५॥"]},{"t":"shloka","x":["सङ्कट कटै मिटै सब पीरा।","जो सुमिरै हनुमत बलवीरा॥३६॥"]},{"t":"shloka","x":["जै जै जै हनुमान गोसाईं।","कृपा करहु गुरु देव की नाईं॥३७॥"]},{"t":"shloka","x":["यह शत पार पाठ कर कोई।","छूटहि बंदि महा सुख होई॥३८॥"]},{"t":"shloka","x":["यो यह पढ़ै हनुमान् चलीसा।","होय सिद्धि साखी गौरीसा॥३९॥"]},{"t":"shloka","x":["तुलसीदास सदा हरि चेरा।","कीजै नाथ हृदय मँह डेरा॥४०॥"]},{"t":"shloka","x":["राम लक्ष्मण जानकी।","जय बोलो हनुमान् की॥"]}]}