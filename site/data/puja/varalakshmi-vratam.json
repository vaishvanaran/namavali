":["न्यूनं वाऽप्यगुणं वाऽपि यन्मया मोहितं कृतम्।","सर्वं तदस्तु सम्पूर्णं त्वत्प्रसादान्महेश्वरि॥"]},{"t":"verse","x":["लक्ष्मि त्वत्कृपया नित्यं कृता पूजा तवाऽऽज्ञया।","स्थिरा भव गृहे ह्यस्मिन् मम सन्तानकर्मणि॥"]},{"t":"verse","x":["कायेन वाचा मनसेन्द्रियैर्वा बुद्‌ध्याऽऽत्मना वा प्रकृतेः स्वभावात्।","करोमि यद्यत् सकलं परस्मै नारायणायेति समर्पयामि॥"]},{"t":"prose","x":["सर्वं तत्सद्ब्रह्मार्पणमस्तु।"]}]}]},{"title":"व्रत-कथा","sections":[{"title":"कथा [व्रतराजः]","blocks":[{"t":"h3","x":"सूत उवाच"},{"t":"verse","x":["कैलासशिखरे रम्ये सर्वदेवनिषेविते।","गौर्या सह महादेवो दीव्यन्नक्षैर्विनोदतः॥"]},{"t":"verse","x":["जितोऽसि त्वं मया चाऽऽह पार्वती परमेश्वरम्।","सोऽपि त्वं च जितेत्याह सुविवादस्तयोरभूत्॥"]},{"t":"verse","x":["चित्रनेमिस्तदा पृष्टो मृषावादमभाषत।","तदा कोपसमाविष्टा गौरी शापं ददौ ततः॥"]},{"t":"verse","x":["कुष्ठी भव मृषावादिन् चित्रनेमिर्हतप्रभः।","नानृतेन समं पापं क्वाऽपि दृष्टं श्रुतं मया॥"]},{"t":"verse","x":["चित्रनेमिर्महाप्राज्ञः सत्यं वदति नो मृषा।","प्रसादः क्रियतां देवि देवीमाह वृषध्वजः॥"]},{"t":"verse","x":["प्रसादसुमुखी तस्मै विशापं च जगाद सा।","यदा सरोवरे रम्ये करिष्यन्ति शुचिव्रतम्॥"]},{"t":"verse","x":["ततः स्वर्गणिकाः सर्वं यक्ष्यन्ति त्वां समाहिताः।","तदा तव विशापः स्यादित्युक्तः स पपात ह॥"]},{"t":"verse","x":["ततः कतिपयाहोभिश्चित्रनेमिः सरोवरे।","कुष्ठी भूत्वा वसंस्तत्र ददर्श स्वर्विलासिनीः॥"]},{"t":"verse","x":["देवतापूजनासक्ताः पप्रच्छ प्रणिपत्य ताः।","किमेतद्भो महाभागाः किं पूजा किं च वाञ्छितम्॥"]},{"t":"verse","x":["किं मया च ह्यनुष्ठेयमिहामुत्र फलप्रदम्।","इति व्रतं चित्रनेमिः पप्रच्छ स्वर्विलासिनीः॥"]},{"t":"verse","x":["येनाहं गिरिजाशापान्मोक्ष्यामि चिरदुःखतः।","ता ऊचुः क्रियतामद्य त्वया चैतदनुत्तमम्॥"]},{"t":"verse","x":["वरलक्ष्मीव्रतं दिव्यं सर्वकामसमृद्धिदम्।","यदा रवौ कुलीरस्थे मासे च श्रावणे तथा॥"]},{"t":"verse","x":["गङ्गायमुनयोर्योगे तुङ्गभद्रासरित्तटे।","तस्मिन्वै श्रावणे मासि शुक्लपक्षे भृगोर्दिने॥"]},{"t":"verse","x":["प्रारब्धव्यं व्रतं तत्र महालक्ष्म्या यतात्मभिः।","सुवर्णप्रतिमां कुर्याच्चतुर्भुजसमन्विताम्॥"]},{"t":"verse","x":["पूर्वं गृहमलङ्कृत्य तोरणै रङ्गवल्लिभिः।","गृहस्य पूर्वदिग्भागे ईशान्यां च विशेषतः॥"]},{"t":"verse","x":["प्रस्थमितांस्तण्डुलांश्च भूमौ निक्षिप्य पद्मके।","संस्थाप्य कलशं तत्र तीर्थतोयैः प्रपूरयेत्॥"]},{"t":"verse","x":["फलानि च विनिक्षिप्य सुवर्णं प्रक्षिपेत्ततः।","पल्लवांश्च विनिक्षिप्य वस्त्रेणाच्छाद्य यत्नतः॥"]},{"t":"verse","x":["प्रतिमां स्थापयेत् तत्र पूजयेच्च यथाविधि।","अग्न्युत्तारणपूर्वं तु शुद्धस्नानं यथाक्रमम्॥"]},{"t":"verse","x":["पञ्चामृतेन स्नपनं कारयेन्मन्त्रतः सुधीः।","अभिषेकं ततः कृत्वा देवीसूक्तेन वै ततः॥"]},{"t":"verse","x":["अष्टगन्धैः समभ्यर्च्य पल्लवैश्च समर्चयेत्।","अश्वत्थवटबिल्वाम्रमालतीदाडिमास्तथा॥"]},{"t":"verse","x":["एतेषां पत्राण्यादाय एकविंशतिसङ्ख्यया।","नामाविधैस्तथा पुष्पैर्मालत्यादिसमुद्भवैः॥"]},{"t":"verse","x":["धूपदीपैर्महालक्ष्मीं पूजयेत् सर्वकामदाम्।","पायसैर्भक्ष्यभोज्यैश्च नानाव्यञ्जनसंयुतैः॥"]},{"t":"verse","x":["एकविंशतिसङ्ख्याकैरपूपैः पूजयेच्छिवाम्।","निवेद्य सर्वदेव्यै तु वरं स वृणुयात्ततः॥"]},{"t":"verse","x":["नृत्यगीतादिसहितो देवीं सम्प्रार्थयेच्छ्रियम्।","रमां सरस्वतीं ध्यायेच्छचीं च प्रियवादिनीम्॥"]},{"t":"verse","x":["एवं व्रतविधिं तस्मै कथयित्वा विधानतः।","पञ्चवायनकान् दत्त्वा कथां शृण्वीत यत्नतः॥"]},{"t":"verse","x":["तथा मौनं गृहीत्वा तु पञ्चार्तिक्येन पूजयेत्।","व्रतं च कुर्वता गृह्य एकं पूगफलं तथा॥"]},{"t":"verse","x":["पर्णेकं चूर्णरहितं चर्वणीयं प्रयत्नतः।","चैलखण्डे दृढं बद्ध्वा प्रातः पश्येद्विचक्षणः॥"]},{"t":"verse","x":["आरक्तं यदि जायेत कुर्याद् व्रतमनुत्तमम्।","नो चेन्न तद् व्रतं कार्यं सर्वथा भूतिमिच्छता॥"]},{"t":"verse","x":["अनेनैव विधानेन व्रतं गृह्णीत यत्नतः।","अप्सरोभिः कृतं सम्यग्व्रतं सर्वसमृद्धिदम्॥"]},{"t":"verse","x":["पूजावसानपर्यन्तं चित्रनेमिरलोकयत्।","धूपधूमं समाघ्राय घृतदीपप्रभावतः॥"]},{"t":"verse","x":["गतकुष्ठः स्वर्णतेजाः शुचिस्तद्गतमानसः।","अहं यत्नात् करिष्यामि व्रतं सर्वसमृद्धिदम्॥"]},{"t":"verse","x":["इत्युक्त्वा सर्वदेवीस्तु कारयामास तत्क्षणात्।","सुवर्णनिर्मितां देवीं वस्त्रालङ्कारसंयुताम्॥"]},{"t":"verse","x":["पूर्वोक्तेन विधानेन पूजां कृत्वा प्रयत्नतः।","ततो वैणवपात्राणि फलान्नैश्च सदक्षिणैः॥"]},{"t":"verse","x":["एकविंशतिपक्वान्नैः पूरितानि विधाय च।","पञ्चवायनकान्येवं कृत्वादात्तु यथाक्रमम्॥"]},{"t":"verse","x":["विप्राय चाथ यतये देव्यै तु ब्रह्मचारिणे।","सुवासिन्यै ततस्त्वेकमर्पितं चित्रनेमिना॥"]},{"t":"verse","x":["एवं सम्यक् क्रमेणैतद्दत्त्वा वायनपञ्चकम्।","ततो गृहं गतः सोऽथ देवीं नत्वा यथाक्रमम्॥"]},{"t":"verse","x":["नागवल्लीदलं त्वेकं क्रमुकं चूर्णवर्जितम्।","भक्षयित्वा तु चैलान्ते बद्ध्वा प्रातर्निरैक्षत॥"]},{"t":"verse","x":["आरक्ते च ततो जाते व्रतं चक्रे स भक्तितः।","अद्याहं गतपापोऽस्मि देवीदर्शनयोगतः॥"]},{"t":"verse","x":["एतत्सम्यग्व्रतं चीर्णं भक्तिभावेन यन्मया।","चित्रनेमिव्रतं कृत्वा कैलासं शङ्करालयम्॥"]},{"t":"verse","x":["गत्वा प्रणम्य देवेशं देवीमादरपूर्वकम्।","पार्वती च तदा प्राह चित्रनेमे स्वपुत्रवत्॥"]},{"t":"verse","x":["पालनीयो मया त्वं च सत्यमित्यवधार्यताम्।","चित्रनेमिस्तदा प्राह पार्वतीं हरवल्लभे॥"]},{"t":"verse","x":["तव पादाम्बुजं दृष्टं वरलक्ष्मीप्रसादतः।","महादेवस्ततः प्राह चित्रनेमिं शुचिव्रतम्॥"]},{"t":"verse","x":["अद्यप्रभृति कैलासे भुङ्क्ष्व भोगान् यथेप्सितान्।","पश्चाद्गन्तासि वैकुण्ठं वरस्यास्य प्रसादतः॥"]},{"t":"verse","x":["पार्वत्याऽपि कृतं पूर्वं पुत्रलाभार्थमेव च।","लब्धश्च षण्मुखो देव्या व्रतराजप्रसादतः॥"]},{"t":"verse","x":["नन्दश्च विक्रमादित्यो राज्यं प्राप्तौ महाव्रतौ।","नन्दश्च कान्तया हीनः कान्तां लेभे सुलक्षणाम्॥"]},{"t":"verse","x":["तया च तद् व्रतं कृत्स्नं कृतं वै पुत्रहेतवे।","पुत्रं प्रसुषुवे सा च त्रैलोक्यभरणक्षमम्॥"]},{"t":"verse","x":["इह भुक्त्वा तु विपुलान्भोगान्वै सुमनोहरान्।","तदाप्रभृति लोकेऽस्मिन् वरलक्ष्मीव्रतं शुभम्॥"]},{"t":"verse","x":["व्रतं करोति या नारी नरो वाऽपि शुचिव्रतः।","भुक्त्वा भोगांश्च विपुलानन्ते शिवपुरं व्रजेत्॥"]},{"t":"verse","x":["इत्याख्यातं मया विप्रा वरलक्ष्मीव्रतं शुभम्।","य इदं शृणुयान्नित्यं श्रावयेद्वा समाहितः॥"]},{"t":"prose","x":["धनं धान्यमवाप्नोति वरलक्ष्मीप्रसादतः"]},{"t":"prose","x":["॥इति श्रीभविष्योत्तरपुराणे श्रावणशुक्रवारे वरलक्ष्मीव्रतं सम्पूर्णम्॥"]}]},{"title":"कथा [भविष्योत्तरपुराणम्]","blocks":[{"t":"verse","x":["कैलासशिखरे रम्ये नानागणनिषेविते।","मन्दारविटपिप्रीते नानामणिविभूषिते॥"]},{"t":"verse","x":["पाटलाशोकपुन्नागखर्जूरवकुलान्विते।","कुबेरवरुणेन्द्रादिदिक्पालैश्च समावृते॥"]},{"t":"verse","x":["नारदागस्त्यवाल्मीकिपराशरसमावृते।","रत्नपीठे सुखासीनं शङ्करं लोकशङ्करम्॥"]},{"t":"prose","x":["*","पप्रच्छ गौरी सन्तुष्टा लोकानुग्रहकाम्यया"]},{"t":"h3","x":"पार्वत्युवाच"},{"t":"prose","x":["*","भगवन् सर्वलोकेश सर्वभूतहिते रत"]},{"t":"prose","x":["*","यद्रहस्यमिदं पुण्यं तदाचक्ष्व ममानघ"]},{"t":"h3","x":"ईश्वर उवाच"},{"t":"prose","x":["व्रतानामुत्तमं नाम सर्वसौभाग्यकारणम्"]},{"t":"verse","x":["सर्वसम्पत्प्रदं शीघ्रं पुत्रपौत्रप्रवर्धनम्।","वरलक्ष्मीव्रतं नाम व्रतमस्ति मनोहरम्॥"]},{"t":"verse","x":["शुक्ले श्रावणिके मासे पूर्णिमोपान्त्यभार्गवे।","यदा तु नारी वर्तेत व्रते तस्याः फलं शृणु॥"]},{"t":"h3","x":"पार्वत्युवाच"},{"t":"verse","x":["विधिना केन कर्तव्यं तत्र का नाम देवता।","कया चाऽऽराधिता पूर्वं साऽभूत् सन्तुष्टमानसा॥"]},{"t":"h3","x":"ईश्वर उवाच"},{"t":"verse","x":["वरलक्ष्मीव्रतं पुण्यं वक्ष्यामि शृणु पार्वति।","कुण्डिनं नाम नगरं सर्वमण्डनमण्डितम्॥"]},{"t":"verse","x":["हेमप्राकारसंयुक्तं चामीकरगृहोज्ज्वलम्।","तत्राभूद् ब्राह्मणी काचिन्नाम्ना चारुमती श्रुता॥"]},{"t":"verse","x":["पतिभक्तिरता साध्वी श्वश्रूश्वशुरयोर्मता।","कलावती सा विदुषी सततं मञ्जुभाषिणी॥"]},{"t":"verse","x":["तस्याः प्रसन्नचित्ताया लक्ष्मीः स्वप्नगता तदा।","एहि कल्याणि भद्रं ते वरलक्ष्मीः समागता॥"]},{"t":"verse","x":["नभोमासे पूर्णिमायां नातिक्रान्ते भृगोर्दिने।","मत्पूजा तत्र कर्तव्या वरं दास्यामि काङ्क्षितम्॥"]},{"t":"verse","x":["इत्युक्तां वरलक्ष्मीं सा तुष्टाव परया मुदा।","नमस्ते सर्वलोकानां जनन्यै पुण्यमूर्तये॥"]},{"t":"verse","x":["शरण्ये त्रिजगद्वन्द्ये विष्णुवक्षःस्थलालये।","त्वयाऽवलोकितः सद्यः स धन्यः स गुणान्वितः॥"]},{"t":"verse","x":["स श्लाघ्यः स कुशलम्बी च स शूरः स च पण्डितः।","जन्मान्तरसहस्रेषु किं मया सुकृतं कृतम्॥"]},{"t":"verse","x":["अतस्त्वत्पादयुगलं पश्यामि हरिवल्लभे।","एवं स्तुता सा कमला प्रादात् तस्यै बहून् वरान्॥"]},{"t":"verse","x":["ततश्चारुमती साध्वी स्वप्नादुत्थाय सम्भ्रमात्।","तत्सर्वं कथयामास बन्धूनां पुरतस्तदा॥"]},{"t":"verse","x":["श्रुत्वा तु बान्धवाः सर्वे साधु साध्विति चाब्रुवन्।","तथैव करवामेति तदागमनकाङ्क्षिणः॥"]},{"t":"verse","x":["भाग्योदयेन सम्प्राप्ते वरलक्ष्मीदिने तथा।","स्त्रियः प्रसन्नहृदया निर्मलाश्चित्रवाससः॥"]},{"t":"verse","x":["नूतनैस्तण्डुलैः पूर्णे कुम्भे च वटपल्लवैः।","सायं चारुमतीमुख्याश्चक्रुः पूजां प्रयत्नतः॥"]},{"t":"verse","x":["पद्मासने पद्मकरे सर्वलोकैकपूजिते।","नारायणप्रिये देवि सुप्रीता भव सर्वदा॥"]},{"t":"verse","x":["इत्यादिमन्त्रैः सकलैरुपचारा यथाक्रमम्।","कृत्वा तु दक्षिणे हस्ते नवसूत्रं दधुः स्त्रियः॥"]},{"t":"verse","x":["हविष्यं सघृतं चैव वरलक्ष्म्यै न्यवेदयन्।","गन्धादिभिरलङ्कृत्य सुशीलं वृद्धभूसुरम्॥"]},{"t":"verse","x":["तस्मै दत्त्वा वायनं च द्वादशापूपसंयुतम्।","ततो देवीसमीपे तु हविष्यं चक्रुरङ्गनाः॥"]},{"t":"verse","x":["अथ लक्ष्मीप्रसादेन मुक्तामाणिक्यभूषिताः।","नूपुराक्रान्तचरणा मणिकाञ्चनभूषणाः॥"]},{"t":"verse","x":["पुत्रपौत्रैः परिवृता धनधान्यसमृद्धिभिः।","अन्नदानरता नित्यं बन्धुपोषणतत्पराः॥"]},{"t":"verse","x":["स्वं स्वं सद्म समाजग्मुर्हस्त्यश्वरथसङ्कुलम्।","अन्योन्यं कथयामासुः श्रुतं चारुमतीमुखात्॥"]},{"t":"verse","x":["इदं सत्यमिदं सत्यं नरो भद्राणि पश्यति।","वयं चारुमतीमुख्या उपलब्धमनोरथाः॥"]},{"t":"verse","x":["पुण्या चारुमती धन्या भूयो भाग्यवती चिरम्।","स्वयं यस्यान्महालक्ष्म्या बोधितं हि व्रतोत्तमम्॥"]},{"t":"verse","x":["इति चारुमतीं साध्वीं तुष्टुवुस्तत्र योषितः।","वरलक्ष्मीव्रतं नाम तदादि भुवि विश्रुतम्॥"]},{"t":"verse","x":["एतत् ते सर्वमाख्यातं व्रतानामुत्तमं व्रतम् य इदं शृणुयाद्वापि श्रावयेद्वा समाहितः।","सिद्ध्यन्ति सर्वकार्याणि वरलक्ष्मीप्रसादतः॥"]}]}]}]}