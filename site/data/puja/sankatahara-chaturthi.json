["*","किं ध्यानं श्रीगणेशस्य गणेश वद विस्तरात्"]},{"t":"h3","x":"गणेश उवाच"},{"t":"prose","x":["चतुर्थ्यां प्रातरुत्थाय दन्तधावनपूर्वकम्"]},{"t":"verse","x":["ग्राह्यं व्रतमिदं पुण्यं सङ्कष्टतरणं शुभम्।","कर्तव्यमिति सङ्कल्प्य व्रतेऽस्मिन् गणपं स्मरेत्॥"]},{"t":"prose","x":["स्वीकारमन्त्रः—"]},{"t":"verse","x":["निराहारोऽस्मि देवेश यावच्चन्द्रोदये भवेत्।","भोक्ष्यामि पूजयित्वाऽहं सङ्कष्टात् तारयस्व माम्॥"]},{"t":"verse","x":["एवं सङ्कल्प्य राजेन्द्र स्नात्वा कृष्णतिलैः शुभैः।","आह्निकं तु विधायैव पश्चात्पूज्यो गणाधिपः॥"]},{"t":"verse","x":["त्रिभिर्माषैस्तदर्धेन तृतीयांशेन वा पुनः।","यथाशक्त्या तु वा हैमी प्रतिमा क्रियते मम॥"]},{"t":"verse","x":["हेमाभावे तु रौप्यस्य ताम्रस्यापि यथासुखम्।","सर्वथैव दरिद्रेण क्रियते मृन्मयी शुभा॥"]},{"t":"verse","x":["वित्तशाठ्यं न कर्तव्यं कृते कार्यं विनश्यति।","जलपूर्णं वस्त्रयुतं कुम्भं तदुपरि न्यसेत्॥"]},{"t":"verse","x":["पूर्णपात्रं तत्र पद्मं लिखेदष्टदलं शुभम्।","देवतां तत्र संस्थाप्य गन्धपुष्पैः प्रपूजयेत्॥"]},{"t":"verse","x":["एवं व्रतं प्रकर्तव्यं प्रतिमासं त्वयाऽद्रिजे।","यावज्जीवं तु वा वर्षाण्येकविंशतिमेव वा॥"]},{"t":"verse","x":["अशक्तोऽप्येकवर्षं वा प्रतिवर्षमथापि वा।","उद्यापनं तु कर्तव्यं चतुर्थ्यां श्रावणेऽसिते॥"]},{"t":"verse","x":["स्वीकारश्च तथा कार्यः सङ्कष्टहरणे तिथौ।","गाणपत्यं तथाऽऽचार्यं सर्वशास्त्रविशारदम्॥"]},{"t":"verse","x":["श्रद्धया प्रार्थयेदादौ तेनोक्तं विधिमाचरेत्।","एकविंशतिविप्रांश्च वस्त्रालङ्कारभूषणैः॥"]},{"t":"verse","x":["पूजयेद् गोहिरण्याद्यैर्हुत्वाऽग्नौ विधिपूर्वकम्।","होमद्रव्यं मोदकाश्च तिलयुक्ता घृतप्लुताः॥"]},{"t":"verse","x":["अष्टोत्तरसहस्रं वा नोचेदष्टोत्तरं शतम्।","अष्टाविंशतिसङ्ख्याकान् मोदकान् वा सशर्करान्॥"]},{"t":"verse","x":["अशक्तोऽष्टौ शुभान् स्थूलाञ्जुहुयाज्जातवेदसि।","वैदिकेन च मन्त्रेण आगमोक्तेन वा तथा॥"]},{"t":"verse","x":["अथवा नाममन्त्रेण होमं कुर्याद् यथाविधि।","पुष्पमण्डपिका कार्या गणेशाह्लादकारिणी॥"]},{"t":"verse","x":["पूजयेत् तत्र गणपं भक्तसङ्कष्टनाशनम्।","गीतवादित्रनिनदैर्भक्तिभावपुरस्कृतैः॥"]},{"t":"verse","x":["पुराणवेदनिर्घोषैस्तोषयेच्च गणेश्वरम्।","एवं जागरणं कार्यं शक्त्या दानादिकं तथा॥"]},{"t":"verse","x":["सपत्नीकमथाऽऽचार्यं तोषयेद् वस्त्रभूषणैः।","उपानच्छत्रगोदानकमण्डलुफलादिभिः॥"]},{"t":"verse","x":["शय्यावाहनभूदानं धनधान्यगृहादिभिः।","यथाशक्त्या प्रकर्तव्यं दारिद्र्याभावमिच्छता॥"]},{"t":"verse","x":["एकविंशतिविप्रांश्च भोजयेन्नामभिर्मम।","गजास्यो विघ्नराजश्च लम्बोदरशिवात्मजौ॥"]},{"t":"verse","x":["वक्रतुण्डः शूर्पकर्णः कुब्जश्चैव विनायकः।","विघ्ननाशो हि विकटो वामनः सर्वदैवतः॥"]},{"t":"verse","x":["सर्वार्तिनाशी भगवान् विघ्नहर्ता च धूम्रकः।","सर्वदेवाधिदेवश्च सर्वे षोडश वै स्मृताः॥"]},{"t":"verse","x":["एकदन्तः कृष्णपिङ्गो भालचन्द्रो गणेश्वरः।","गणपश्चैकविंशश्च सर्व एते गणेश्वराः॥"]},{"t":"verse","x":["दुर्गोपेन्द्रश्च रुद्रश्च कुलदेव्याधिकं भवेत्।","विशेषेणाष्टसङ्ख्याकैर्मोदकैर्हवनं स्मृतम्॥"]},{"t":"verse","x":["एवं कृते विधानेन प्रसन्नोऽहं न संशयः।","ददामि वाञ्छितान् कामांस्तद्व्रतं मत्प्रियं कुरु॥"]},{"t":"h3","x":"श्रीकृष्ण उवाच"},{"t":"verse","x":["एवं तु कथितं सर्वं गणेशेन स्वयं नृप।","पार्वत्या तत्कृतं राजन् व्रतं सङ्कष्टनाशनम्॥"]},{"t":"verse","x":["व्रतेनानेन सा प्राप महादेवं पतिं स्वकम्।","तत् कुरुष्व महाराज व्रतं सङ्कष्टनाशनम्॥"]},{"t":"verse","x":["चतुर्थी सङ्कटा नाम स्कन्देन कथिता ऋषीन्।","ऋषिभिर्लोककामैस्तैर्लोके ततमिदं व्रतम्॥"]},{"t":"h3","x":"सूत उवाच"},{"t":"verse","x":["कृतं युधिष्ठिरेणैतद् राज्यकामेन वै द्विज।","तेन शत्रून् निहत्याऽऽजौ स्वराज्यं प्राप्तवान् स्वयम्॥"]},{"t":"verse","x":["तस्मात् सर्वप्रयत्नेन व्रतं कार्यं विचक्षणैः।","येन धर्मार्थकामाश्च मोक्षश्चापि भवेत् किल॥"]},{"t":"verse","x":["यः करोति व्रतं विप्राः सर्वकामार्थसिद्धिदम्।","स वाञ्छितफलं प्राप्य पश्चाद् गणपतां व्रजेत्॥"]},{"t":"verse","x":["यदा यदा परं विप्रा नरः प्राप्नोति सङ्कटम्।","तदा तदा प्रकर्तव्यं व्रतं सङ्कष्टनाशनम्॥"]},{"t":"verse","x":["त्रिपुरं हन्तुकामेन कृतं देवेन शूलिना।","त्रैलोक्यभूतिकामेन महेन्द्रेण तथा कृतम्॥"]},{"t":"verse","x":["रावणेन कृतं पूर्वं वालिबन्धनसङ्कटे।","स्वकीयं प्राप्तवान् राज्यं गणेशस्य प्रसादतः॥"]},{"t":"verse","x":["सीतान्वेषणकामेन कृतं वायुसुतेन च।","सङ्कल्प्य दृष्टवान् सोऽयं सीतां रामप्रियां पुरा॥"]},{"t":"verse","x":["दमयन्त्या कृतं पूर्वं नलान्वेषणकारणात् सा पतिं नैषधं लेभे पुण्यश्लोकं द्विजोत्तमाः।","अहल्याऽपि पतिं लेभे गौतमं प्राणवल्लभम्॥"]},{"t":"verse","x":["विद्यार्थी लभते विद्यां धनार्थी धनमाप्नुयात्।","पुत्रार्थी पुत्रमाप्नोति रोगी रोगात् प्रमुच्यते॥"]},{"t":"prose","x":["॥इति श्रीस्कन्दपुराणोक्तं सङ्कष्टचतुर्थीव्रतम्॥"]},{"t":"prose","x":["मुद्गलपुराणान्तर्गत-चतुर्थीव्रत-माहात्म्यानि"]},{"t":"list","x":[["चतुर्थी-तपो-वर्णनम्"],["शुक्ल--कृष्ण-चतुर्थी-वरदान-वर्णनम्"],["प्रतिपदादिव्रत-वर्णनम्"],["दशरथ-व्रतोपदेशः"],["चतुर्थीविवेक-वर्णनम्"],["चन्द्रदर्शन-दोष-हरण-चरित-वर्णनम्"],["भाद्रपद-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["आश्विन-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["कार्तिक-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["मार्गशीर्ष-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["पौष-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["माघ-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["फाल्गुन-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["चैत्र-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["वैशाख-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["ज्येष्ठ-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["आषाढ-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["श्रावण-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["मलमास-शुक्ल-चतुर्थी-माहात्म्य-वर्णनम्"],["माघ-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["फाल्गुन-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["चैत्र-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["वैशाख-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["ज्येष्ठ-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["आषाढ-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["श्रावण-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["भाद्रपद-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["आश्विन-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["कार्तिक-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["मार्गशीर्ष-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["पौष-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["मलमास-कृष्ण-चतुर्थी-माहात्म्य-वर्णनम्"],["शमी-मूल-चतुर्थी-व्रताचरण-वर्णनम्"],["वसिष्ठ-दशरथ-संवाद-समाप्ति-वर्णनम्"],["चतुर्थ्युद्यापन-निरूपणम्"]]}]}]}]}